<view class="ns-page">
  <view class="ns-top" style="{{nav.topbarStyle}}"><button bindtap="goBack" class="ns-back" aria-label="返回夜喵"><image src="/assets/agent/icons/arrow-left-muted.png"/></button><text>夜喵设置</text></view>
  <scroll-view class="ns-scroll" scroll-y><view class="ns-content">
    <text class="ns-title">{{fromChat ? '对话设置' : '设置'}}</text>
    <view class="ns-section"><text class="ns-section-title">夜喵陪伴</text>
      <button class="ns-row" hover-class="is-pressed" bindtap="openPreferences"><view><text>我的睡前偏好</text><text class="ns-help">让夜喵了解你</text></view><text class="ns-value">设置 ›</text></button>
      <view class="ns-memory"><view class="ns-row"><view><text class="ns-memory-title">夜喵记忆</text><text class="ns-help">开启后，夜喵会记住你的习惯和偏好，让每次聊天更贴近你。</text></view><switch checked="{{prefs.memoryEnabled}}" color="#ebc979" data-key="memoryEnabled" bindchange="toggle"/></view><text class="ns-help">当前仅保存在本机，聊天服务接入后使用。</text><view class="ns-memory-actions"><button bindtap="manageMemory">管理记忆 ›</button><button class="ns-danger" bindtap="deleteMemory">删除记忆</button></view></view>
    </view>
    <view wx:if="{{fromChat}}" class="ns-section ns-section--ai"><text class="ns-section-title">对话设置</text><text class="ns-help ns-section-intro">调整夜喵的陪伴方式和对话体验</text>
      <button class="ns-row" hover-class="is-pressed" data-key="personality" bindtap="choose"><view><text>夜喵性格</text><text class="ns-help">选择夜喵陪伴你的方式</text></view><text class="ns-value">{{prefs.personality}} ›</text></button>
      <button class="ns-row" hover-class="is-pressed" data-key="voice" bindtap="choose"><view><text>夜喵声音</text><text class="ns-help">声音偏好 · 语音待接入</text></view><text class="ns-value">{{prefs.voice}} ›</text></button>
      <button class="ns-row" hover-class="is-pressed" data-key="model" bindtap="info"><text>默认对话模型</text><text class="ns-value">夜喵智能模型 ›</text></button>
      <view class="ns-row"><view><text>猜你想问</text><text class="ns-help">根据你的偏好推荐聊天主题</text></view><switch checked="{{prefs.suggestions}}" color="#ebc979" data-key="suggestions" bindchange="toggle"/></view>
      <button class="ns-row" hover-class="is-pressed" data-key="question" bindtap="choose"><view><text>默认引导问题</text><text class="ns-help">进入夜喵时显示的问题</text></view><text class="ns-value">{{prefs.question}} ›</text></button>
      <button class="ns-row" hover-class="is-pressed" bindtap="advanced"><text>高级设置</text><text class="ns-value">{{advanced ? '收起' : '展开'}} ›</text></button><button wx:if="{{advanced}}" class="ns-row" data-key="api" bindtap="info"><text>自定义 API</text><text class="ns-value">尚未接入 ›</text></button>
    </view>
    <view class="ns-section"><text class="ns-section-title">夜喵的技能</text><text class="ns-help ns-section-intro">夜喵可以帮你播放声音、记日记。这里控制每个技能的执行方式，并标注它写入的数据范围。</text>
      <button class="ns-row" hover-class="is-pressed" wx:for="{{skills}}" wx:key="name" data-name="{{item.name}}" bindtap="chooseSkillPermission"><view><text>{{item.label}}</text><text class="ns-help">{{item.help}}</text><text class="ns-help">{{item.scope}}</text></view><text class="ns-value">{{item.permissionLabel}} ›</text></button>
      <button class="ns-row" hover-class="is-pressed" bindtap="goMemoryFile"><view><text>夜喵的记忆档案</text><text class="ns-help">夜喵记得的你的近况</text></view><text class="ns-value">查看 ›</text></button>
    </view>
    <view wx:if="{{!fromChat}}" class="ns-section"><text class="ns-section-title">显示与提醒</text><text class="ns-subheading">显示设置</text>
      <button class="ns-row" hover-class="is-pressed" data-key="display" bindtap="choose"><text>首页展示</text><text class="ns-value">{{prefs.display}} ›</text></button><button class="ns-row" hover-class="is-pressed" data-key="fontSize" bindtap="choose"><text>字号大小</text><text class="ns-value">{{prefs.fontSize}} ›</text></button>
      <text class="ns-subheading">通知设置</text><button class="ns-row" hover-class="is-pressed" data-key="reminder" bindtap="info"><view><text>提醒设置</text><text class="ns-help">睡前提醒 · 早睡打卡 · 感恩日记</text></view><text class="ns-value">未接入 ›</text></button>
    </view>
    <view wx:if="{{!fromChat}}" class="ns-section"><text class="ns-section-title">账户与隐私</text><button class="ns-row" hover-class="is-pressed" data-key="login" bindtap="info"><text>微信账号</text><text class="ns-value">未登录 ›</text></button><button class="ns-row" hover-class="is-pressed" bindtap="openData"><text>数据管理</text><text class="ns-value">本地数据 ›</text></button><button class="ns-row" hover-class="is-pressed" data-key="guide" bindtap="info"><text>重新认识好眠猫</text><text class="ns-value">›</text></button><text class="ns-subheading">关于</text><view class="ns-row"><text>版本</text><text class="ns-value">{{version}}</text></view><button class="ns-row" hover-class="is-pressed" data-key="privacy" bindtap="info"><text>隐私政策</text><text class="ns-value">›</text></button><button class="ns-row" hover-class="is-pressed" data-key="terms" bindtap="info"><text>用户协议</text><text class="ns-value">›</text></button><button class="ns-row" hover-class="is-pressed" data-key="contact" bindtap="info"><text>联系我们</text><text class="ns-value">›</text></button></view>
  </view></scroll-view>
  <view wx:if="{{panel}}" class="ns-overlay" catchtap="closePanel"><view class="ns-sheet" catchtap="noop"><view class="ns-sheet-heading"><text>{{panelTitle}}</text><button bindtap="closePanel" aria-label="关闭"><image src="/assets/agent/icons/x-muted.png"/></button></view><scroll-view class="ns-sheet-scroll" scroll-y><view class="ns-sheet-inner">
    <view wx:if="{{panel === 'preferences'}}"><picker mode="time" value="{{prefs.bedtime}}" bindchange="changeBedtime"><view class="ns-row"><text>通常入睡时间</text><text class="ns-value">{{prefs.bedtime}} ›</text></view></picker><button class="ns-row" hover-class="is-pressed" data-key="companion" bindtap="choose"><text>喜欢的陪伴方式</text><text class="ns-value">{{prefs.companion}} ›</text></button><text class="ns-subheading">常见睡前困扰</text><checkbox-group bindchange="changeConcerns"><label wx:for="{{selectedConcerns}}" wx:key="label" class="ns-row"><text>{{item.label}}</text><checkbox value="{{item.label}}" checked="{{item.checked}}" color="#ebc979"/></label></checkbox-group></view>
    <view wx:if="{{panel === 'memory'}}"><text class="ns-help">{{prefs.memoryEnabled ? '记忆已开启' : '记忆已关闭'}} · 本机偏好</text><text class="ns-full">通常入睡时间：{{prefs.bedtime}}
喜欢的陪伴方式：{{prefs.companion}}
常见睡前困扰：{{prefs.concerns.length ? prefs.concerns : '未设置'}}</text><text class="ns-help">当前没有自动提取的聊天记忆。</text><button class="ns-row" hover-class="is-pressed" bindtap="openPreferences"><text>编辑偏好</text><text>›</text></button><button class="ns-row ns-danger" bindtap="deleteMemory">删除记忆</button></view>
    <view wx:if="{{panel === 'data'}}"><button class="ns-row" hover-class="is-pressed" bindtap="goRecords"><text>查看睡眠记录与日记</text><text>›</text></button><button class="ns-row" hover-class="is-pressed" data-key="sleep" bindtap="clearData"><text>睡眠记录 · {{sleepCount}} 条</text><text class="ns-danger">删除</text></button><button class="ns-row" hover-class="is-pressed" data-key="journal" bindtap="clearData"><text>感恩日记 · {{journalCount}} 篇</text><text class="ns-danger">删除</text></button><button class="ns-row" hover-class="is-pressed" bindtap="manageMemory"><text>夜喵记忆</text><text>管理 ›</text></button></view>
    <text wx:if="{{panel === 'info'}}" class="ns-full">{{panelText}}</text>
  </view></scroll-view></view></view>
</view>
