:host {
  display: block;
  width: 100%;
  height: 100%;
}

.world {
  position: relative;
  width: 100%;
  height: 100%;
  overflow: hidden;
  --scene: #d8e8cf;
  --scene-rgb: 216, 232, 207;
}

.world--mist { --scene: #c9ded9; --scene-rgb: 201, 222, 217; }
.world--moon { --scene: #efe8c8; --scene-rgb: 239, 232, 200; }
.world--water { --scene: #a9d2ce; --scene-rgb: 169, 210, 206; }
.world--stardust { --scene: #d6d8c8; --scene-rgb: 214, 216, 200; }
.world--stardust { background: #030b13; }

.starfield-animation {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
}

.world--stardust .ambient,
.world--stardust .ambient-particle,
.world--stardust .vignette {
  display: none;
}
.world--firefly { --scene: #dce89b; --scene-rgb: 220, 232, 155; }
.world--warmLight { --scene: #f2c99f; --scene-rgb: 242, 201, 159; }
.world--orb { --scene: #c6e0d4; --scene-rgb: 198, 224, 212; }

.vignette {
  position: absolute;
  z-index: 12;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  pointer-events: none;
  background: radial-gradient(circle at center, transparent 34%, rgba(1, 11, 12, 0.34) 100%);
}

.ambient {
  position: absolute;
  width: 420rpx;
  height: 220rpx;
  border-radius: 50%;
  opacity: 0.11;
  filter: blur(44rpx);
  background: var(--scene);
  animation: ambientDrift 12s ease-in-out infinite alternate;
}

.ambient--one { left: -120rpx; top: 20%; }
.ambient--two { right: -160rpx; bottom: 12%; animation-delay: -5s; }

.ambient-particle {
  position: absolute;
  z-index: 1;
  border-radius: 50%;
  opacity: 0.22;
  background: var(--scene);
  box-shadow: 0 0 16rpx rgba(var(--scene-rgb), 0.4);
  animation: particleFloat 7.5s ease-in-out infinite alternate;
  transition: opacity 2.4s ease, transform 3.8s ease;
}

.phase--inhale .ambient-particle {
  opacity: 0.3;
  transform: scale(0.86);
}

.phase--exhale .ambient-particle {
  opacity: 0.08;
  transform: scale(1.18) translateY(-10rpx);
  transition-duration: 5.8s;
}

.dandelion {
  position: absolute;
  left: 50%;
  top: 52%;
  width: 620rpx;
  height: 820rpx;
  transform: translate(-50%, -50%);
}

.dandelion-canvas { width: 100%; height: 100%; }

.dandelion-fallback {
  position: relative;
  width: 100%;
  height: 100%;
  transition: transform 4s ease-in-out;
  animation: fallbackSway 6s ease-in-out infinite alternate;
}

.fallback-glow {
  position: absolute;
  left: 50%;
  top: 43%;
  width: 420rpx;
  height: 420rpx;
  margin-left: -210rpx;
  margin-top: -210rpx;
  border-radius: 50%;
  background: rgba(223, 188, 126, 0.08);
  box-shadow: 0 0 110rpx rgba(226, 198, 142, 0.14);
  transition: transform 4s ease-in-out, opacity 4s ease-in-out;
}

.fallback-head { position: absolute; left: 50%; top: 43%; width: 2rpx; height: 2rpx; }
.fallback-filament {
  position: absolute;
  left: 0;
  top: 0;
  height: 1rpx;
  transform-origin: 0 50%;
  background: rgba(241, 226, 194, 0.76);
  transition: opacity 1.8s ease, transform 4s ease-in-out;
}
.fallback-filament--rear { opacity: 0.24 !important; }
.fallback-filament--middle { opacity: 0.46 !important; }
.fallback-filament--front { height: 2rpx; }
.fallback-tuft {
  position: absolute;
  right: -8rpx;
  top: -8rpx;
  width: 15rpx;
  height: 15rpx;
  border: 1rpx dotted rgba(255, 242, 210, 0.66);
  border-radius: 50%;
  box-shadow: 0 0 8rpx rgba(255, 244, 210, 0.36);
}
.fallback-core {
  position: absolute;
  left: -15rpx;
  top: -15rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #79502e;
  box-shadow: 0 0 28rpx rgba(207, 157, 82, 0.42);
}
.fallback-core__grain { width: 12rpx; height: 12rpx; margin: 9rpx; border-radius: 50%; background: #bd8c50; box-shadow: 8rpx -5rpx 0 rgba(70,45,26,.7), -7rpx 5rpx 0 rgba(221,177,96,.42); }
.fallback-stem {
  position: absolute;
  left: 50%;
  top: 43%;
  width: 4rpx;
  height: 370rpx;
  margin-left: -2rpx;
  border-radius: 4rpx;
  background: rgba(126, 116, 72, 0.76);
  transform: rotate(-2deg);
  transform-origin: 50% 0;
}
.fallback-seed { position: absolute; left: 66%; top: 35%; width: 24rpx; height: 38rpx; opacity: 0; }
.fallback-seed__tuft { width: 20rpx; height: 20rpx; border: 1rpx solid rgba(255, 248, 224, 0.72); border-radius: 50%; }
.fallback-seed__tail { width: 1rpx; height: 22rpx; margin-left: 10rpx; background: rgba(236, 218, 180, 0.8); }
.phase--inhale .dandelion-fallback { transform: scale(1.05) rotate(-0.8deg); }
.phase--inhale .fallback-glow { opacity: 1; transform: scale(1.08); }
.phase--hold .dandelion-fallback { transform: scale(1.05) rotate(0.7deg); }
.phase--exhale .dandelion-fallback { transform: scale(0.98) rotate(4deg); }
.phase--exhale .fallback-glow { opacity: 0.55; transform: scale(1.18); }
.phase--exhale .fallback-filament:nth-child(4n) { opacity: 0.08 !important; }
.phase--exhale .fallback-filament:nth-child(5n) { opacity: 0.14 !important; }
.phase--exhale .fallback-seed { animation-duration: 6.8s; animation-timing-function: ease-out; animation-fill-mode: both; }
.phase--exhale .fallback-seed--0 { animation-name: fallbackSeedFly0; }
.phase--exhale .fallback-seed--1 { animation-name: fallbackSeedFly1; }
.phase--exhale .fallback-seed--2 { animation-name: fallbackSeedFly2; }
.phase--exhale .fallback-seed--3 { animation-name: fallbackSeedFly3; }
.phase--completed .fallback-seed { opacity: 0; }

.world--body .dandelion,
.world--body .mist-cloud,
.world--body .moon-disc,
.world--body .moon-halo,
.world--body .water-line,
.world--body .water-ripple,
.world--body .water-glow,
.world--body .star-core,
.world--body .star,
.world--body .firefly-center,
.world--body .firefly,
.world--body .warm-ray,
.world--body .warm-core,
.world--body .orb-ring,
.world--body .orb-core {
  display: none;
}

.world--body .ambient {
  opacity: 0.055;
}

.world--body .ambient-particle {
  opacity: 0.1;
}

.mist-cloud {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  filter: blur(38rpx);
  transform: translate(-50%, -50%);
  background: rgba(var(--scene-rgb), 0.2);
  transition: width 5.5s ease-out, height 5.5s ease-out, opacity 5.5s ease-out, transform 4s ease;
}

.mist-cloud--one { width: 300rpx; height: 180rpx; }
.mist-cloud--two { width: 210rpx; height: 270rpx; opacity: 0.7; }
.mist-cloud--three { width: 150rpx; height: 150rpx; opacity: 0.4; }
.phase--inhale .mist-cloud { transform: translate(-50%, -50%) scale(0.72); opacity: 0.7; }
.phase--exhale .mist-cloud { width: 650rpx; height: 460rpx; opacity: 0; }

.moon-disc,
.moon-halo {
  position: absolute;
  left: 50%;
  top: 48%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: all 4.8s ease;
}

.moon-disc {
  z-index: 4;
  width: 180rpx;
  height: 180rpx;
  overflow: hidden;
  background: #eae5ca;
  box-shadow: 0 0 55rpx rgba(var(--scene-rgb), 0.3);
}

.moon-shadow {
  position: absolute;
  top: -22rpx;
  right: -12rpx;
  width: 164rpx;
  height: 164rpx;
  border-radius: 50%;
  background: #0a2021;
}

.moon-halo--inner { width: 250rpx; height: 250rpx; background: rgba(var(--scene-rgb), 0.08); }
.moon-halo--outer { width: 390rpx; height: 390rpx; background: rgba(var(--scene-rgb), 0.035); }
.phase--inhale .moon-disc { box-shadow: 0 0 110rpx rgba(var(--scene-rgb), 0.65); transform: translate(-50%, -50%) scale(1.08); }
.phase--exhale .moon-halo--inner { width: 500rpx; height: 500rpx; opacity: 0; }
.phase--exhale .moon-halo--outer { width: 720rpx; height: 720rpx; opacity: 0; }

.water-line {
  position: absolute;
  left: 8%;
  right: 8%;
  top: 52%;
  height: 1rpx;
  background: rgba(var(--scene-rgb), 0.2);
}

.water-ripple {
  position: absolute;
  left: 50%;
  top: 52%;
  width: 100rpx;
  height: 30rpx;
  border: 2rpx solid rgba(var(--scene-rgb), 0.52);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  opacity: 0.2;
}

.water-ripple--1 { width: 230rpx; height: 65rpx; opacity: 0.13; }
.water-ripple--2 { width: 390rpx; height: 100rpx; opacity: 0.08; }
.water-glow { position: absolute; left: 50%; top: 51%; width: 18rpx; height: 18rpx; border-radius: 50%; transform: translate(-50%, -50%); background: var(--scene); box-shadow: 0 0 70rpx 24rpx rgba(var(--scene-rgb), 0.25); }
.phase--inhale .water-ripple { animation: rippleInhale 4s ease-in-out both; }
.phase--exhale .water-ripple { animation: rippleExhale 5.8s ease-out both; }
.water-ripple--1 { animation-delay: 0.5s !important; }
.water-ripple--2 { animation-delay: 1s !important; }

.star-core,
.firefly-center,
.warm-core,
.orb-core {
  position: absolute;
  z-index: 4;
  left: 50%;
  top: 49%;
  width: 82rpx;
  height: 82rpx;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: rgba(var(--scene-rgb), 0.68);
  box-shadow: 0 0 90rpx rgba(var(--scene-rgb), 0.46);
  transition: all 4.8s ease;
}

.star {
  position: absolute;
  border-radius: 50%;
  background: var(--scene);
  box-shadow: 0 0 18rpx rgba(var(--scene-rgb), 0.68);
  animation: starPulse 2.8s ease-in-out infinite alternate;
  transition: left 4s ease, top 4s ease, transform 5.5s ease, opacity 5.5s ease;
}

.phase--inhale .star { left: 50% !important; top: 49% !important; }
.phase--exhale .star { transform: scale(1.6); opacity: 0.05; }
.phase--inhale .star-core { width: 52rpx; height: 52rpx; box-shadow: 0 0 120rpx rgba(var(--scene-rgb), 0.8); }

.firefly {
  position: absolute;
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--scene);
  box-shadow: 0 0 22rpx 7rpx rgba(var(--scene-rgb), 0.32);
  animation: fireflyWander 5s ease-in-out infinite alternate;
  transition: left 3.8s ease, top 3.8s ease, opacity 5s ease;
}

.firefly--1 { animation-delay: -1.3s; }
.firefly--2 { animation-delay: -2.7s; }
.firefly--3 { animation-delay: -4s; }
.phase--inhale .firefly { left: 50% !important; top: 49% !important; }
.phase--exhale .firefly { opacity: 0.05; }
.firefly-center { width: 34rpx; height: 34rpx; opacity: 0.55; }

.warm-ray {
  position: absolute;
  left: 50%;
  top: 48%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: rgba(var(--scene-rgb), 0.09);
  filter: blur(28rpx);
  transition: all 5.5s ease;
}

.warm-ray--one { width: 420rpx; height: 420rpx; }
.warm-ray--two { width: 260rpx; height: 260rpx; opacity: 0.8; }
.warm-core { width: 130rpx; height: 130rpx; background: rgba(var(--scene-rgb), 0.45); }
.phase--inhale .warm-core { width: 170rpx; height: 170rpx; box-shadow: 0 0 150rpx rgba(var(--scene-rgb), 0.66); }
.phase--exhale .warm-ray { width: 720rpx; height: 720rpx; opacity: 0; }

.orb-ring {
  position: absolute;
  left: 50%;
  top: 49%;
  border: 1rpx solid rgba(var(--scene-rgb), 0.2);
  border-radius: 50%;
  transform: translate(-50%, -50%);
  transition: all 5.5s ease;
}

.orb-ring--inner { width: 240rpx; height: 240rpx; }
.orb-ring--outer { width: 360rpx; height: 360rpx; opacity: 0.55; }
.orb-core { width: 170rpx; height: 170rpx; background: rgba(var(--scene-rgb), 0.27); }
.phase--inhale .orb-core { width: 135rpx; height: 135rpx; opacity: 0.9; box-shadow: 0 0 130rpx rgba(var(--scene-rgb), 0.7); }
.phase--exhale .orb-core { width: 420rpx; height: 420rpx; opacity: 0.05; }
.phase--exhale .orb-ring { width: 650rpx; height: 650rpx; opacity: 0; }

.body-focus {
  position: absolute;
  z-index: 20;
  width: 20rpx;
  height: 20rpx;
  transform: translate(-50%, -50%);
}

.body-focus__halo,
.body-focus__core {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  background: rgba(var(--scene-rgb), 0.3);
}

.body-focus__halo { width: 150rpx; height: 150rpx; animation: focusPulse 3.4s ease-in-out infinite; }
.body-focus__core { width: 24rpx; height: 24rpx; box-shadow: 0 0 42rpx rgba(var(--scene-rgb), 0.75); }
.phase--inhale .body-focus__halo { width: 210rpx; height: 210rpx; background: rgba(var(--scene-rgb), 0.5); }
.phase--exhale .body-focus__halo { width: 390rpx; height: 390rpx; opacity: 0; transition: all 5.5s ease; }

@keyframes ambientDrift { from { transform: translate3d(-5%, -4%, 0); } to { transform: translate3d(8%, 7%, 0); } }
@keyframes particleFloat { from { transform: translateY(-8rpx); opacity: 0.12; } to { transform: translateY(12rpx); opacity: 0.32; } }
@keyframes dandelionFloatAway { 0% { opacity: 0.72; transform: translate(-50%, -50%) scale(0.72); } 18% { opacity: 0.82; } 100% { opacity: 0; transform: translate(calc(-50% + var(--drift-x)), calc(-50% + var(--drift-y))) scale(0.24) rotate(18deg); } }
@keyframes dandelionBreeze { from { margin-left: -5rpx; } to { margin-left: 7rpx; } }
@keyframes rippleInhale { from { transform: translate(-50%, -50%) scale(1); opacity: 0.08; } to { transform: translate(-50%, -50%) scale(0.58); opacity: 0.55; } }
@keyframes rippleExhale { from { transform: translate(-50%, -50%) scale(0.55); opacity: 0.5; } to { transform: translate(-50%, -50%) scale(2.2); opacity: 0; } }
@keyframes starPulse { from { opacity: 0.2; } to { opacity: 0.82; } }
@keyframes fireflyWander { from { transform: translate(-12rpx, -8rpx); } to { transform: translate(16rpx, 14rpx); } }
@keyframes focusPulse { 0%, 100% { transform: translate(-50%, -50%) scale(0.9); opacity: 0.24; } 50% { transform: translate(-50%, -50%) scale(1.12); opacity: 0.48; } }
@keyframes fallbackSway { from { margin-left: -4rpx; } to { margin-left: 5rpx; } }
@keyframes fallbackSeedFly0 { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg); } 12% { opacity: 0.82; } 100% { opacity: 0; transform: translate(120rpx, -110rpx) rotate(28deg); } }
@keyframes fallbackSeedFly1 { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg); } 12% { opacity: 0.82; } 100% { opacity: 0; transform: translate(180rpx, -175rpx) rotate(34deg); } }
@keyframes fallbackSeedFly2 { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg); } 12% { opacity: 0.82; } 100% { opacity: 0; transform: translate(235rpx, -135rpx) rotate(22deg); } }
@keyframes fallbackSeedFly3 { 0% { opacity: 0; transform: translate(0, 0) rotate(0deg); } 12% { opacity: 0.82; } 100% { opacity: 0; transform: translate(290rpx, -220rpx) rotate(38deg); } }

/* Warm-gold reference treatment: the source photograph carries the fine
   filaments and dark receptacle that are lost in a pure CSS illustration. */
.world--dandelion .photo-fallback { display: none; }
.world--dandelion .dandelion { left: 0; top: 0; width: 100%; height: 100%; transform: none; }
.dandelion-photo-layer { position: absolute; z-index: 5; left: 0; top: 0; right: 0; bottom: 0; width: 100%; height: 100%; overflow: visible; }
.dandelion-stem-static {
  position: absolute;
  z-index: 1;
  left: 50%;
  top: 43%;
  width: 520rpx;
  height: 650rpx;
  transform: translate(-50%, -50%);
  animation: none !important;
  pointer-events: none;
}
.dandelion-crown-anchor {
  position: absolute;
  left: calc(50% + 28.36rpx);
  top: calc(43% - 57.91rpx);
  width: 0;
  height: 0;
  overflow: visible;
  pointer-events: none;
}
.dandelion-crown-motion {
  position: absolute;
  left: -288.36rpx;
  top: -267.09rpx;
  width: 520rpx;
  height: 650rpx;
  transform-origin: 55.45% 41.09%;
  pointer-events: none;
}
.dandelion-crown {
  position: absolute;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  transition: opacity 420ms ease;
  pointer-events: none;
}
.world--dandelion .dandelion-stem-static { opacity: .98; }
.world--dandelion .dandelion-crown--full { opacity: .98; }
.world--dandelion .dandelion-crown--loosened { opacity: 0; }
.world--dandelion .dandelion-crown--sparse { opacity: 0; }
.world--dandelion.phase--inhale .dandelion-crown--full {
  opacity: 1;
}
.world--dandelion.phase--hold .dandelion-crown--full { opacity: 0; }
.world--dandelion.phase--hold .dandelion-crown--loosened { opacity: 1; }
.world--dandelion.phase--exhale .dandelion-crown--full { opacity: 0; }
.world--dandelion.phase--exhale .dandelion-crown--loosened { opacity: .18; }
.world--dandelion.phase--exhale .dandelion-crown--sparse { opacity: .82; }
.world--dandelion.phase--completed .dandelion-crown--full,
.world--dandelion.phase--completed .dandelion-crown--loosened { opacity: 0; }
.world--dandelion.phase--completed .dandelion-crown--sparse { opacity: .74; }
.world--dandelion.phase--inhale .dandelion-crown-motion {
  animation: crownFerrisRotate 4s linear both;
}
.world--dandelion.phase--hold .dandelion-crown-motion {
  animation: crownHoldSway 1.8s ease-in-out infinite;
}
.world--dandelion.phase--exhale .dandelion-crown-motion {
  animation: crownExhaleRotate 7.6s linear both;
}
.world--dandelion.phase--completed .dandelion-crown-motion {
  animation: none;
}
.photo-seeds {
  position: absolute;
  z-index: 2;
  left: calc(50% + 28.36rpx);
  top: calc(43% - 57.91rpx);
  width: 0;
  height: 0;
  overflow: visible;
  pointer-events: none;
}
.photo-seed {
  position: absolute;
