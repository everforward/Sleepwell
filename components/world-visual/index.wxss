@keyframes crownHoldSway {
  0% { transform: rotate(-10deg) scale(1.04); }
  50% { transform: rotate(10deg) scale(1.07); }
  100% { transform: rotate(-10deg) scale(1.04); }
}
@keyframes crownFerrisRotate {
  0% { transform: rotate(0deg) scale(1.02); }
  100% { transform: rotate(360deg) scale(1.08); }
}
@keyframes crownExhaleRotate {
  0% { transform: rotate(0deg) scale(1.02); }
  35% { transform: rotate(105deg) scale(1.01); }
  70% { transform: rotate(210deg) scale(.99); }
  100% { transform: rotate(300deg) scale(.97); }
}
.photo-seeds--completed .photo-seed {
  opacity: 0;
  transform: translate3d(180rpx, -120rpx, 0) rotate(32deg) scale(.24);
}
.photo-seeds--completed .photo-seed:nth-child(-n+4) {
  opacity: .16;
  transform: translate3d(118rpx, -94rpx, 0) rotate(26deg) scale(.3);
  transition: opacity 1.8s ease;
}

